# HealthForm AI Environment Configuration

# Application
APP_NAME="HealthForm AI"
APP_VERSION="1.0.0"
DEBUG=True

# Database
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="healthform_ai"

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Mode (If true, uses deterministic grounded extraction and RAG mock generator without requiring paid API keys)
DEMO_MODE=true

# AI Provider Keys (Optional: Leave empty for offline zero-cost Demo Mode)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
